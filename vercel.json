{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; connect-src *; img-src * data: blob:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/claude.js": { "maxDuration": 120 },
    "api/parse-statement.js": { "maxDuration": 120 },
    "api/push-send.js": { "maxDuration": 120 },
    "api/social.js": { "maxDuration": 180 },
    "api/social-publish.js": { "maxDuration": 180 }
  },
  "crons": [
    {
      "path": "/api/push-send?mode=briefing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/push-send?mode=alerts",
      "schedule": "*/15 7-17 * * 1-5"
    },
    {
      "path": "/api/email-send",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/social?cron=weekly",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/social-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/social?cron=reels",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/social?cron=recap",
      "schedule": "30 18 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    }
  ]
}
