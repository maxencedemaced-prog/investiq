{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://connect.facebook.net https://www.googletagmanager.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; connect-src *; img-src * data: blob:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/claude.js": { "maxDuration": 120 },
    "api/parse-statement.js": { "maxDuration": 120 },
    "api/push-send.js": { "maxDuration": 120 },
    "api/social.js": { "maxDuration": 180 },
    "api/social-publish.js": { "maxDuration": 180 }
  },
  "crons": [
    {
      "path": "/api/push-send?mode=briefing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/push-send?mode=alerts",
      "schedule": "*/15 7-20 * * 1-5"
    },
    {
      "path": "/api/email-send",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/email-send?mode=newsletter",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/social?cron=weekly",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/social-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/social?cron=articles",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/social?cron=stories",
      "schedule": "*/30 5-21 * * *"
    },
    {
      "path": "/api/social?cron=reels",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/social?cron=recap",
      "schedule": "30 18 * * 5"
    }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/commencer", "destination": "/", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.kapitaro.com" }], "destination": "https://kapitaro.com/:path*", "permanent": true },
    { "source": "/en", "has": [{ "type": "host", "value": "kapitaro.fr" }], "destination": "https://kapitaro.com/", "permanent": true },
    { "source": "/en/:path*", "has": [{ "type": "host", "value": "kapitaro.fr" }], "destination": "https://kapitaro.com/:path*", "permanent": true },
    { "source": "/en/:path*", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/:path*", "permanent": true },
    { "source": "/cgu", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/terms", "permanent": true },
    { "source": "/confidentialite", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/privacy", "permanent": true },
    { "source": "/risques", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/risks", "permanent": true },
    { "source": "/mentions-legales", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/legal", "permanent": true },
    { "source": "/simulateur-interets-composes", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/compound-interest-calculator", "permanent": true }
  ],
  "rewrites": [
    { "source": "/terms", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/terms" },
    { "source": "/privacy", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/privacy" },
    { "source": "/cookies", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/cookies" },
    { "source": "/risks", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/risks" },
    { "source": "/legal", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/legal" },
    { "source": "/compound-interest-calculator", "has": [{ "type": "host", "value": "kapitaro.com" }], "destination": "/en/compound-interest-calculator" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/blog-sitemap.xml", "destination": "/api/blog?sitemap=1" },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    }
  ]
}
